[Unit]
Description=IMAP Spam Filter Service (Podman Quadlet)
After=network-online.target

[Container]
Image=imap-spam-filter.build
ContainerName=imap_spam_filter

Secret=imap_pass_secret,type=mount,target=/run/secrets/imap_pass_secret

# Environment variables
EnvironmentFile=%E/imap-filter/imap.env

# Mounts
Volume=%E/imap-filter/config.lua:/home/imap-filter/config/config.lua:ro,Z
Volume=imap-spam-filter-data.volume:/home/imap-filter/data:rw

Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64M,mode=1777
Tmpfs=/home/imap-filter/.imapfilter:rw,size=16M,mode=1777

# Hardening
ReadOnly=True
DropCapability=ALL
NoNewPrivileges=true
User=10001:10001

LogDriver=k8s-file

[Service]
Type=oneshot
RemainAfterExit=no
TimeoutStartSec=300

[Install]
WantedBy=default.target
