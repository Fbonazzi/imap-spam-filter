# Server credentials
IMAP_SERVER=<IMAP SERVER>
IMAP_PORT=993
IMAP_USER=<IMAP USER>
IMAP_SSL=auto

# Remote Folders
IMAP_INBOX_FOLDER=INBOX
IMAP_JUNK_FOLDER=Junk

# Operation mode: 'filter' (classify & move spam), 'train' (batch train on Junk/INBOX), or 'live-train' (interactive live training)
FILTER_MODE=filter

# Operational Tuning
BATCH_SIZE=25
MAX_MSG_SIZE=1048576
TRAIN_MAX_MESSAGES=100
# LIVE_TRAIN_MAX=0 # Review ceiling for live-train: 0 or unset = interactive until 'q'
BOGOFILTER_AUTO_UPDATE=false
